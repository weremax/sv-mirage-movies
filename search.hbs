<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SV Mirage Movies</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" integrity="sha384-JcKb8q3iqJ61gNV9KGb8thSsNjpSL0n8PARn9HuZOnIxN0hoP+VmmDGMN5t9UJ0Z" crossorigin="anonymous">
    <link rel="stylesheet" href="../css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com"> 
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin> 
    <link href="https://fonts.googleapis.com/css2?family=Cookie&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lodash.js/4.17.15/lodash.min.js"></script>
    <script>

        function clearField() {
            document.getElementById("search").value = ""
            {{!-- fetch(`http://localhost:3000/search?search=`)
                .then((response) => response.json())
                .then((data) => {
                        movies = data.movies
                        console.log(movies)
                }); --}}
        }

        function filterMovies() {
        console.log(document.getElementById("search").value)
            fetch(`http://localhost:3000/search?search=${document.getElementById("search").value}`)
                .then((response) => response.json())
                .then((data) => {
                    console.log(data)
                        movies = data
                        console.log(movies)
                });
        }
    </script>
</head>
<body>
    <div class="parent">
        <div class="title">
            <h1>List of Movies</h1>
        </div>
        Search by title:<br/>
        <form>
            <input type="text" id="search" onkeyup="filterMovies()">
            <button type="button" onclick="clearField()">Clear</button>
        </form>
        
        <small>Number of Movies ({{data.filtered.length}}) of ({{data.count}})</small><br/><br/>

        <ul class="movies">
            {{#each data.movies}}
            {{#ifeq this.name }}
                <li class={{this.selected}}>
                    {{this.name}}</li>
            {{/ifeq}}
            {{/each}}
        </ul>
        
    </div>

</body>
</html>

